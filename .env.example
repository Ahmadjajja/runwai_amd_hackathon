# Copy to ".env" in this directory (repo root). Never commit real tokens.

# --- Hugging Face Router (OpenAI-compatible) + Qwen (recommended) ---
OPENAI_BASE_URL=https://router.huggingface.co
OPENAI_API_KEY=
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct:together

# Optional: same token name some notebooks use (adapter reads if OPENAI_API_KEY is empty)
# HF_TOKEN=

# --- Or: Hugging Face Inference API (no OPENAI_BASE_URL) ---
# HF_API_KEY=
# HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# Sampling / limits
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
ML_ADVISORY_TEMPERATURE=0.42
ML_ADVISORY_MAX_TOKENS=2048

# LangChain path for OpenAI-compatible URLs (default on). Set 0 for raw httpx only.
# USE_LANGCHAIN=1
